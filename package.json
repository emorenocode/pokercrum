{
  "name": "pokercrum",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "pnpm build:env",
    "build:env": "ts-node scripts/set-env.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/fire": "20.0.1",
    "@angular/forms": "^22.1.4",
    "@angular/material": "22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "dotenv": "^17.2.3",
    "firebase": "^12.4.0",
    "nanoid": "^5.1.6",
    "ngx-skeleton-loader": "^13.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
