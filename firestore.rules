rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validUsername(username) {
      return username is string && username.trim().length >= 2 && username.trim().length <= 30;
    }

    function isRoomOwner(roomId) {
      return signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.id == roomId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.timer is number
        && request.resource.data.timer >= 10
        && request.resource.data.timer <= 120
        && validUsername(request.resource.data.name) == false;

      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid;

      allow delete: if false;

      match /players/{playerId} {
        allow get: if signedIn();
        allow list: if signedIn();

        allow create, update: if signedIn()
          && request.resource.data.id == playerId
          && request.resource.data.room == roomId
          && validUsername(request.resource.data.username)
          && request.resource.data.fromMobile is bool;

        allow delete: if signedIn()
          && (resource.data.id == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid);
      }
    }
  }
}
